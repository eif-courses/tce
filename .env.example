# === Nuxt/Nitro Server Configuration ===
# Nuxt server port (frontend + API proxy)
PORT=3000
NODE_ENV=development

# Go Backend URL (Nitro will proxy API requests to this)
GO_BACKEND_URL=http://localhost:8080

# === Go Backend Configuration (for reference) ===
# These are used by the Go backend when running separately
# Backend listens on: http://localhost:8080
# LOG_LEVEL=debug
# RULES_CONFIG=config/rules.yaml
OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"   # optional, defaults in code